# === AI MODEL PROVIDER (optional; only needed for --autogen) ===
# AI_PROVIDER=openai|openrouter|groq|github|local
AI_PROVIDER=openrouter
AI_MODEL=qwen/qwen3-coder:free

# OpenAI-compatible providers. Fill only the provider you use.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GITHUB_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
LOCAL_AI_API_KEY=local
LOCAL_AI_BASE_URL=

# === OPTIONAL NOTIFICATIONS ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === OPTIONAL DATA SOURCES ===
ETHERSCAN_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CryptoAlphaScanner/1.0
TWITTER_BEARER_TOKEN=
WHALE_ALERT_API_KEY=

# === OPTIONAL AUTO-TRADING ===
# Default is paper trading. Live orders require TRADING_MODE=live and LIVE_TRADING=true.
AUTO_TRADE=false
WATCH_MODE=false
SCAN_INTERVAL_MINUTES=15
TRADING_MODE=paper
TRADING_EXCHANGE=paper
LIVE_TRADING=false
PAPER_TRADES_PATH=data/paper_trades.jsonl
POSITION_STATE_PATH=data/positions.json
BINANCE_API_KEY=
BINANCE_API_SECRET=
TRADING_QUOTE_SYMBOL=USDT

# === OPTIONAL TRADINGVIEW WEBHOOK ===
TRADINGVIEW_WEBHOOK_HOST=127.0.0.1
TRADINGVIEW_WEBHOOK_PORT=8787
TRADINGVIEW_WEBHOOK_SECRET=
BINANCE_TESTNET=false

# Future simulation safety gate is configured in config.yaml.
REQUIRE_FUTURE_SIMULATION=true

# === LOCAL DASHBOARD ===
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8788
